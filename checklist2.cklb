arget Red Hat Enterprise Linux 9DISADPMS TargetRed Hat Enterprise Linux 95551","responsibility":"","mitigations":"","mitigation_control":"","legacy_ids":[],"ccis":["CCI-000366"],"reference_identifier":"","uuid":"6ff904f3-88eb-4628-96a6-1786bbf7bb1f","stig_uuid":"60b479aa-95a2-4ee3-8e16-aacb5df86c87","status":"not_reviewed","overrides":{},"comments":"","finding_details":"","srg_id":""},{"group_id_src":"V-257907","group_tree":[{"id":"V-257907","title":"SRG-OS-000480-GPOS-00227","description":"<GroupDescription></GroupDescription>"}],"group_id":"V-257907","severity":"medium","group_title":"SRG-OS-000480-GPOS-00227","rule_id_src":"SV-257907r991589_rule_rule","rule_id":"SV-257907r991589_rule","rule_version":"RHEL-09-232135","rule_title":"RHEL 9 /etc/passwd file must be group-owned by root.","fix_text":"Change the group of the file /etc/passwd to root by running the following command:\n\n$ sudo chgrp root /etc/passwd","weight":"10.0","check_content":"Verify the group ownership of the \"/etc/passwd\" file with the following command:\n\n$ sudo stat -c \"%G %n\" /etc/passwd \n\nroot /etc/passwd\n\nIf \"/etc/passwd\" file does not have a group owner of \"root\", this is a finding.","check_content_ref":{"href":"U_RHEL_9_V2R9_STIG.zip","name":"M"},"classification":"Unclassified","discussion":"The \"/etc/passwd\" file contains information about the users that are configured on the system. Protection of this file is critical for system security.","false_positives":"","false_negatives":"","documentable":"false","security_override_guidance":"","potential_impacts":"","third_party_tools":"","ia_controls":"DPMS Target Red Hat Enterprise Linux 9DISADPMS TargetRed Hat Enterprise Linux 95551","responsibility":"","mitigations":"","mitigation_control":"","legacy_ids":[],"ccis":["CCI-000366"],"reference_identifier":"","uuid":"7475c9f9-9866-4239-b2b4-65d0efd1ff56","stig_uuid":"60b479aa-95a2-4ee3-8e16-aacb5df86c87","status":"not_reviewed","overrides":{},"comments":"","finding_details":"","srg